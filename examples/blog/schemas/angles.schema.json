{
  "type": "object",
  "required": ["angles"],
  "additionalProperties": false,
  "properties": {
    "angles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["slug", "title", "claim", "supported_by"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+){1,3}$" },
          "title": { "type": "string", "maxLength": 60 },
          "claim": { "type": "string", "maxLength": 200 },
          "supported_by": { "type": "string", "maxLength": 300 }
        }
      }
    }
  }
}
