{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teachings extracted from one video",
  "type": "object",
  "required": ["teachings"],
  "additionalProperties": false,
  "properties": {
    "teachings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "title", "claim", "bucket", "sources", "seed"],
        "additionalProperties": false,
        "properties": {
          "slug":   { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+){0,4}$" },
          "title":  { "type": "string", "maxLength": 70 },
          "claim":  { "type": "string", "maxLength": 300 },
          "bucket": { "type": "string" },
          "seed":   { "type": "boolean" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["at", "quote"],
              "additionalProperties": false,
              "properties": {
                "at":    { "type": "string", "pattern": "^[0-9]{1,3}:[0-5][0-9]$" },
                "quote": { "type": "string", "maxLength": 240 }
              }
            }
          }
        }
      }
    }
  }
}
