{
  "type": "object",
  "required": ["ideas"],
  "additionalProperties": false,
  "properties": {
    "ideas": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["slug", "title", "premise"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+){1,3}$" },
          "title": { "type": "string", "maxLength": 60 },
          "premise": { "type": "string", "maxLength": 240 }
        }
      }
    }
  }
}
